wc3_player_controls:
wc3_hp_hook1:
  pushfd
  pushad
  cmp dword ptr [wc3_hp_god],0
  jne wc3_hp_classify1
  cmp dword ptr [wc3_hp_selected_god],0
  jne wc3_hp_classify1
  cmp dword ptr [wc3_hp_enemy_one],0
  je wc3_hp_done1
wc3_hp_classify1:
  mov ecx,esi
  call wc3_hp_classify
  cmp eax,1
  je wc3_hp_own1
  cmp eax,3
  je wc3_hp_protect1
  cmp eax,2
  je wc3_hp_enemy1
  jmp wc3_hp_done1
wc3_hp_own1:
  cmp dword ptr [wc3_hp_god],0
  jne wc3_hp_protect1
  cmp dword ptr [wc3_hp_selected_god],0
  je wc3_hp_done1
  mov eax,[wc3_selected_player]
  cmp eax,[wc3_hp_local_id]
  jne wc3_hp_done1
wc3_hp_protect1:
  cmp dword ptr [esi+78],0
  jle wc3_hp_done1
  mov eax,[esp+14]
  cmp eax,[esi+78]
  jge wc3_hp_done1
  mov eax,[esi+78]
  mov [esp+14],eax
  inc dword ptr [wc3_hp_protected]
  jmp wc3_hp_done1
wc3_hp_enemy1:
  cmp dword ptr [wc3_hp_enemy_one],0
  je wc3_hp_done1
  mov eax,[esp+14]
  cmp eax,3F800000
  jle wc3_hp_done1
  cmp dword ptr [esi+78],0
  jle wc3_hp_done1
  mov dword ptr [esp+14],3F800000
wc3_hp_done1:
  popad
  popfd
  mov [esi+78],edx
  mov ecx,esi
  jmp wc3_hp_return1

wc3_hp_hook2:
  pushfd
  pushad
  lea eax,[esi+78]
  cmp edi,eax
  jne wc3_hp_done2
  cmp dword ptr [wc3_hp_god],0
  jne wc3_hp_classify2
  cmp dword ptr [wc3_hp_selected_god],0
  jne wc3_hp_classify2
  cmp dword ptr [wc3_hp_enemy_one],0
  je wc3_hp_done2
wc3_hp_classify2:
  mov ecx,esi
  call wc3_hp_classify
  cmp eax,1
  je wc3_hp_own2
  cmp eax,3
  je wc3_hp_protect2
  cmp eax,2
  je wc3_hp_enemy2
  jmp wc3_hp_done2
wc3_hp_own2:
  cmp dword ptr [wc3_hp_god],0
  jne wc3_hp_protect2
  cmp dword ptr [wc3_hp_selected_god],0
  je wc3_hp_done2
  mov eax,[wc3_selected_player]
  cmp eax,[wc3_hp_local_id]
  jne wc3_hp_done2
wc3_hp_protect2:
  cmp dword ptr [esi+78],0
  jle wc3_hp_done2
  mov eax,[esp+14]
  cmp eax,[esi+78]
  jge wc3_hp_done2
  mov eax,[esi+78]
  mov [esp+14],eax
  inc dword ptr [wc3_hp_protected]
  jmp wc3_hp_done2
wc3_hp_enemy2:
  cmp dword ptr [wc3_hp_enemy_one],0
  je wc3_hp_done2
  mov eax,[esp+14]
  cmp eax,3F800000
  jle wc3_hp_done2
  cmp dword ptr [esi+78],0
  jle wc3_hp_done2
  mov dword ptr [esp+14],3F800000
wc3_hp_done2:
  popad
  popfd
  push edi
  mov ecx,esi
  mov [edi],edx
  jmp wc3_hp_return2

wc3_hp_classify:
  push ebx
  push ebp
  push esi
  push edi
  mov esi,ecx
  mov ebx,[Game.dll+AB65F4]
  test ebx,ebx
  je wc3_hp_other
  movzx ebp,word ptr [ebx+28]
  cmp ebp,0F
  ja wc3_hp_other
  mov [wc3_hp_local_id],ebp
  cmp dword ptr [Game.dll+AB7788],0
  je wc3_hp_other
  mov eax,[esi+30]
  test eax,eax
  je wc3_hp_other
  mov edi,[eax+54]
  test edi,edi
  je wc3_hp_other
  mov eax,Game.dll+931934
  cmp [edi],eax
  jne wc3_hp_other
  mov ecx,[edi+A0]
  mov edx,[edi+A4]
  call Game.dll+03FA30
  cmp eax,esi
  jne wc3_hp_other
  mov eax,[edi+58]
  cmp eax,0F
  ja wc3_hp_other
  mov [wc3_hp_last_owner],eax
  cmp eax,ebp
  jne wc3_hp_test_enemy
  inc dword ptr [wc3_hp_owned_seen]
  mov eax,1
  jmp wc3_hp_classified
wc3_hp_test_enemy:
  cmp dword ptr [wc3_hp_selected_god],0
  je wc3_hp_alliance_test
  cmp eax,[wc3_selected_player]
  jne wc3_hp_alliance_test
  mov eax,3
  jmp wc3_hp_classified
wc3_hp_alliance_test:
  cmp dword ptr [wc3_hp_enemy_one],0
  je wc3_hp_other
  mov edi,eax
  mov ecx,[ebx+ebp*4+58]
  test ecx,ecx
  je wc3_hp_other
  call Game.dll+41B420
  test eax,eax
  je wc3_hp_other
  lea ecx,[eax+38]
  call Game.dll+473170
  mov ecx,edi
  mov edx,1
  shl edx,cl
  test eax,edx
  jne wc3_hp_other
  mov eax,2
  jmp wc3_hp_classified
wc3_hp_other:
  xor eax,eax
wc3_hp_classified:
  pop edi
  pop esi
  pop ebp
  pop ebx
  ret

wc3_build_hook:
  push edx
  cmp dword ptr [wc3_build_self],0
  jne wc3_build_filter
  cmp dword ptr [wc3_build_selected],0
  je wc3_build_original
wc3_build_filter:
  test ecx,ecx
  je wc3_build_normal
  mov edx,Game.dll+931934
  cmp [ecx],edx
  jne wc3_build_normal
  mov edx,[Game.dll+AB65F4]
  test edx,edx
  je wc3_build_normal
  movzx edx,word ptr [edx+28]
  cmp edx,0F
  ja wc3_build_normal
  cmp dword ptr [wc3_build_self],0
  je wc3_build_test_selected
  cmp [ecx+58],edx
  je wc3_build_choose_self
wc3_build_test_selected:
  cmp dword ptr [wc3_build_selected],0
  je wc3_build_normal
  mov edx,[wc3_selected_player]
  cmp edx,0F
  ja wc3_build_normal
  cmp [ecx+58],edx
  jne wc3_build_normal
  mov edx,[wc3_build_selected_mode]
  jmp wc3_build_choose_mode
wc3_build_choose_self:
  mov edx,[wc3_build_self_mode]
wc3_build_choose_mode:
  cmp edx,2
  je wc3_build_instant
  cmp edx,1
  jne wc3_build_normal
wc3_build_fast:
  pop edx
  mov eax,[Game.dll+AAE4F4]
  push esi
  mov esi,[esp+8]
  mov [esi],eax
  jmp Game.dll+281555
wc3_build_instant:
  pop edx
  mov eax,[esp+4]
  mov dword ptr [eax],49742400
  ret 4
wc3_build_normal:
  pop edx
  mov eax,[Game.dll+AAE4F4]
  push esi
  mov esi,[esp+8]
  mov [esi],eax
  jmp Game.dll+281569
wc3_build_original:
  pop edx
  mov eax,[Game.dll+AAE4F4]
  jmp Game.dll+281535

