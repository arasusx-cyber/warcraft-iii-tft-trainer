{$lua}
if syntaxcheck then return end
local resourceScope='self'
local key='wc3_res_'..resourceScope..'_126a'
local previous=rawget(_G,key)
if type(previous)=='table' and previous.initializing then return end
if type(previous)=='table' then
  if previous.stop then previous.stop()
  elseif previous.timer then previous.timer.Enabled=false;previous.timer.destroy() end
end
local state={revision=5,initializing=true,busy=false,stopped=false,pid=getOpenedProcessID(),writes=0,lastError=nil}
-- Publish BEFORE symbol lookup: a lookup callback must not activate us again.
rawset(_G,key,state)
local cfg={};local prefix='wc3_res_'..resourceScope..'_'
local function address(name)
  -- CE's shallow lookup skips Lua symbol callbacks. These are registered data
  -- symbols/module names, never Lua expressions or address-list descriptions.
  return getAddressSafe(name,false,true)
end
local function rd(a) local v=readInteger(a);return v and v%4294967296 end
local function anchored()
  return getOpenedProcessID()==state.pid and cfg.active and address(prefix..'active')==cfg.active
end
local function diagnostic(name,value)
  if cfg[name] then writeInteger(cfg[name],value) end
end
state.stop=function()
  if state.stopped then return end
  state.stopped=true
  if state.timer then state.timer.Enabled=false;state.timer.destroy() end
  if anchored() then writeInteger(cfg.active,0);diagnostic('status',9) end
  if rawget(_G,key)==state then rawset(_G,key,nil) end
end
local function resolve(manager,index,generation)
  if not index or not generation then return nil end
