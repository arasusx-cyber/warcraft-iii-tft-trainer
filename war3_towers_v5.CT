for _,check in ipairs(checks) do
  local actual=readBytes(base+check[1],#check[2],true)
  local same=actual~=nil
  if same then for i,v in ipairs(check[2]) do if actual[i]~=v then same=false;break end end end
  if not same then
    error(string.format('Noclip: niezgodne bajty Game.dll+%X. Oczekiwano: %s. Odczytano: %s. Wylacz poprzedni wpis noclip; jesli to nie pomaga, przepisz ten blad.',check[1],hex(check[2]),hex(actual)))
  end
end
local function export(name)
  for _,s in ipairs({'user32.'..name,'user32.dll.'..name,name}) do
    local a=getAddressSafe(s)
    if a and a&gt;0 and a&lt;4294967296 then return a end
  end
  error('Noclip: nie udalo sie odnalezc funkcji '..name..' w procesie gry. Przepisz ten blad wraz z wersja CE.')
end
return string.format('define(wc3_nc_api_window,%X)\ndefine(wc3_nc_api_keys,%X)',export('GetWindowThreadProcessId'),export('GetAsyncKeyState'))
