{$lua}
if syntaxcheck then return end
-- Only data fields are edited. No remote game calls or shared unit-type data.
local mode='towers'
local key='wc3_objects_'..mode..'_126a'
local prefix=mode=='towers' and 'wc3_tower_' or 'wc3_vuln_'
local base=getAddressSafe('Game.dll')
local pid=getOpenedProcessID()
if not base or not pid or pid==0 then error('Wybierz proces war3.exe.') end
if _G[key] then error('Ta opcja jest juz wlaczona. Wylacz poprzedni wpis.') end
if targetIs64Bit and targetIs64Bit() then error('Wymagany Warcraft III TFT 1.26a (32-bit).') end
local signatures={
  {0x276A19,{0x8B,0x90,0x44,0x02,0,0}},
  {0x77E20,{0x83,0x7C,0x24,0x04,0,0x74,0x07,0x83,0x49,0x20,0x08}},
  {0x2672E0,{0x8B,0x49,0x64,0x8B,0x44,0x24,0x04,0x89,0x08}},
}
for _,s in ipairs(signatures) do
  local b=readBytes(base+s[1],#s[2],true)
  if not b then error('Nie mozna odczytac Game.dll.') end
  for i,v in ipairs(s[2]) do
    if b[i]~=v then error(string.format('Nie ta wersja Game.dll: +%X.',s[1])) end
  end
end
