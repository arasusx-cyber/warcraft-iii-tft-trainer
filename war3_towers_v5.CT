[DISABLE]
{$lua}
if syntaxcheck then return end
for _,key in ipairs({'wc3_res_self_126a','wc3_res_selected_126a','wc3_army_ai_126a'}) do
  local s = _G[key]
  if s then
    if s.stop then s.stop() else
      if s.timer then s.timer.Enabled = false; s.timer.destroy() end
      _G[key] = nil
    end
  end
end
