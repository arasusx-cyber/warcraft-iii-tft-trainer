local function rd(a)
  local v=readInteger(a); if v==nil then return nil end; return v%4294967296
end
local function resolve(m,i,g)
  if not i or not g then return nil end
  local hi=i&gt;=2147483648; local slot=i%2147483648
  local n=rd(m+(hi and 0x3C or 0x1C));local ar=rd(m+(hi and 0x2C or 0xC))
  if not n or slot&gt;=n or not ar or ar==0 then return nil end
